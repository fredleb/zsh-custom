# Per-user secrets — loaded by the framework when this file exists.
#
# Keep permissions restricted to you:
#     chmod 600 ~/.config/zsh-custom/secrets.zsh
#
# Prefer a credential helper over exporting tokens (see the README). If you
# must export one, do it here rather than in ~/.zshrc.
#
# Example:
#     export GITEA_TOKEN="REPLACE_ME"
