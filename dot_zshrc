# ~/.zshrc — managed by chezmoi (source: dot_zshrc).
# Do NOT edit this file in place; edit the source and run `chezmoi apply`.
# Personal settings: ~/.config/zsh/local.zsh or ~/.zshrc.local (untracked).

export ZSH_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/zsh"
export ZSH_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
[[ -d $ZSH_CACHE ]] || mkdir -p -- "$ZSH_CACHE"

# Framework fragments, lexical order.
for _zsc_f in "$ZSH_CONFIG"/conf.d/*.zsh(N); do
  source "$_zsc_f"
done
unset _zsc_f

# User escape hatches, always last.
if [[ -r "$ZSH_CONFIG/local.zsh" ]]; then
  source "$ZSH_CONFIG/local.zsh"
fi
if [[ -r "$HOME/.zshrc.local" ]]; then
  source "$HOME/.zshrc.local"
fi

# Always leave a successful status for scripted/`zsh -c` use.
true
