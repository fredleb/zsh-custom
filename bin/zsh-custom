#!/usr/bin/env bash
# zsh-custom CLI: install | update | doctor | version | uninstall | refresh
set -euo pipefail

REPO_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=lib/common.sh
. "$REPO_DIR/lib/common.sh"

RC="${ZSHRC_CUSTOM_RC:-$HOME/.zshrc}"

usage() {
  cat <<EOF
zsh-custom — $(cat "$REPO_DIR/VERSION" 2>/dev/null || echo unknown)

Usage: zsh-custom <command> [options]

Commands:
  install              inject the managed block and seed the user layer
  update [--version X] upgrade to the latest release tag (or a specific one)
  doctor               report version, paths, dependencies, and problems
  refresh              rebuild the plugin cache
  version              print the framework version
  uninstall            remove the managed block (keeps your user layer)
  help                 show this help
EOF
}

cmd_version() {
  local ver; ver="$(cat "$REPO_DIR/VERSION" 2>/dev/null || echo unknown)"
  printf '%s' "$ver"
  if command -v git >/dev/null 2>&1 && git -C "$REPO_DIR" rev-parse --git-dir >/dev/null 2>&1; then
    local tag; tag="$(git -C "$REPO_DIR" describe --tags --always 2>/dev/null || true)"
    [[ -n $tag && $tag != "$ver" ]] && printf ' (%s)' "$tag"
  fi
  printf '\n'
}

cmd_doctor() {
  local problems=0 f
  printf 'zsh-custom doctor\n'
  printf '  version    : %s\n' "$(cmd_version)"
  printf '  repo       : %s\n' "$REPO_DIR"
  printf '  entrypoint : %s\n' "$REPO_DIR/init.zsh"
  printf '  user layer : %s\n' "$(zshc_user_layer)"
  printf '  cache      : %s\n' "$(zshc_cache_dir)"
  printf '  rc file    : %s\n' "$RC"

  printf '  dependencies:\n'
  if zshc_zsh_version_ok; then
    printf '    zsh      : ok (%s)\n' "$(zsh -c 'echo $ZSH_VERSION')"
  else
    printf '    zsh      : MISSING or too old (need >= 5.4)\n'; problems=1
  fi
  local ap=""
  if ap="$(zshc_antidote_path 2>/dev/null)"; then
    printf '    antidote : ok (%s)\n' "$ap"
  else
    printf '    antidote : MISSING — %s\n' "$(zshc_dep_hint antidote)"; problems=1
  fi
  if command -v starship >/dev/null 2>&1; then
    printf '    starship : ok (%s)\n' "$(starship --version 2>/dev/null | head -n1)"
  else
    printf '    starship : MISSING — %s\n' "$(zshc_dep_hint starship)"; problems=1
  fi

  printf '  user files found:\n'
  local layer; layer="$(zshc_user_layer)"
  local found=0
  for f in plugins.txt conf.d theme.toml secrets.zsh local.zsh; do
    if [[ -e "$layer/$f" ]]; then
      printf '    %s\n' "$layer/$f"; found=1
    fi
  done
  (( found )) || printf '    (none)\n'

  if zshc_has_managed_block "$RC"; then
    printf '  managed block: present in %s\n' "$RC"
  else
    printf '  managed block: MISSING in %s (run: zsh-custom install)\n' "$RC"; problems=1
  fi

  if (( problems )); then
    printf 'result: problems found\n'; return 1
  fi
  printf 'result: ok\n'
}

cmd_update() {
  local target=""
  while (($#)); do
    case "$1" in
      --version) target="${2:-}"; shift 2 || true ;;
      *) shift ;;
    esac
  done
  command -v git >/dev/null 2>&1 || zshc_die "git is required to update"
  git -C "$REPO_DIR" rev-parse --git-dir >/dev/null 2>&1 || zshc_die "not a git checkout"

  local prev; prev="$(git -C "$REPO_DIR" describe --tags --always 2>/dev/null || echo HEAD)"
  git -C "$REPO_DIR" fetch --tags --quiet || zshc_die "git fetch failed"

  local ref="$target"
  if [[ -z $ref ]]; then
    ref="$(git -C "$REPO_DIR" tag --sort=-v:refname | head -n1)"
  fi
  if [[ -z $ref ]]; then
    zshc_log "No release tags found; staying on the current checkout."
    return 0
  fi

  git -C "$REPO_DIR" checkout --quiet "$ref" || zshc_die "could not check out $ref"
  if ! zshc_validate "$REPO_DIR"; then
    zshc_err "update to $ref failed validation; rolling back to $prev"
    git -C "$REPO_DIR" checkout --quiet "$prev" 2>/dev/null || true
    return 1
  fi
  zshc_refresh_cache "$REPO_DIR" || zshc_warn "could not refresh the plugin cache"
  zshc_log "Updated to $ref. Run:  exec zsh"
}

cmd_uninstall() {
  if zshc_remove_managed_block "$RC"; then
    zshc_log "Removed the zsh-custom managed block from $RC."
  else
    zshc_log "No managed block found in $RC."
  fi
  zshc_log "Your user layer was left in place: $(zshc_user_layer)"
}

main() {
  local cmd="${1:-help}"
  [[ $# -gt 0 ]] && shift
  case "$cmd" in
    install)  exec "$REPO_DIR/install.sh" "$@" ;;
    update)   cmd_update "$@" ;;
    doctor)   cmd_doctor ;;
    version)  cmd_version ;;
    refresh)  zshc_refresh_cache "$REPO_DIR" && zshc_log "Plugin cache refreshed." ;;
    uninstall) cmd_uninstall ;;
    help|-h|--help) usage ;;
    *) usage; exit 1 ;;
  esac
}

main "$@"
